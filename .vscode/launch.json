{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "启动《末日枪手突围》浏览器试玩",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "D:\\下载\\nodejs\\node.exe",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--port", "5175"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "outputCapture": "std",
      "env": {
        "NO_COLOR": "1"
      },
      "serverReadyAction": {
        "pattern": "(https?://localhost:[0-9]+/?)",
        "uriFormat": "%s",
        "action": "openExternally"
      }
    },
    {
      "name": "启动《末日枪手突围》（Edge 断点调试）",
      "type": "node",
      "request": "launch",
      "runtimeExecutable": "D:\\下载\\nodejs\\node.exe",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": ["--port", "5175"],
      "cwd": "${workspaceFolder}",
      "console": "internalConsole",
      "outputCapture": "std",
      "env": {
        "NO_COLOR": "1"
      },
      "serverReadyAction": {
        "pattern": "(https?://localhost:[0-9]+/?)",
        "uriFormat": "%s",
        "action": "debugWithEdge"
      }
    }
  ]
}
